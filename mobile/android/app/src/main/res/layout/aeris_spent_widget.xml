<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 this month's spend, budget and today. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/w_bg">
    <TextView
        android:id="@+id/widget_spent_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Spent this month"
        android:textAllCaps="true"
        android:letterSpacing="0.12"
        android:textColor="@color/w_muted"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/widget_spent_amount"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="—"
        android:textColor="@color/w_text"
        android:textSize="28sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="16sp"
        android:autoSizeMaxTextSize="28sp" />

    <TextView
        android:id="@+id/widget_spent_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/w_muted"
        android:textSize="11.5sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_spent_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="@color/w_accent"
        android:textSize="11.5sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
