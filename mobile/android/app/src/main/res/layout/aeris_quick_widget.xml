<?xml version="1.0" encoding="utf-8"?>
<!-- Quick-capture 4x1 widget, mirroring the in-app glass preview: avatar dot,
     "Add expense…", a purple mic button and a teal + button. Tap mic → voice,
     + / rest of the bar → quick add. RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/aeris_glass_bg">

    <!-- avatar stand-in -->
    <ImageView
        android:id="@+id/widget_quick_avatar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/aeris_avatar_dot" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:text="Add expense…"
        android:textColor="#5B6B68"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- purple mic button -->
    <ImageView
        android:id="@+id/widget_quick_voice"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="8dp"
        android:background="@drawable/btn_purple"
        android:src="@drawable/ic_mic"
        android:scaleType="fitCenter" />

    <!-- teal add button -->
    <ImageView
        android:id="@+id/widget_quick_add"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:padding="7dp"
        android:background="@drawable/btn_teal"
        android:src="@drawable/ic_add"
        android:scaleType="fitCenter" />

</LinearLayout>
