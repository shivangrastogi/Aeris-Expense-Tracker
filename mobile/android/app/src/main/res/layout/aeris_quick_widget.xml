<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1 quick capture: tap the bar to type, mic for voice, + for the form. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="16dp"
    android:paddingRight="10dp"
    android:background="@drawable/w_bg">

    <ImageView
        android:id="@+id/widget_quick_avatar"
        android:layout_width="26dp"
        android:layout_height="26dp" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:text="Spent something?"
        android:textColor="@color/w_muted"
        android:textSize="13.5sp"
        android:maxLines="1" />

    <ImageView
        android:id="@+id/widget_quick_voice"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="9dp"
        android:background="@drawable/w_btn_soft"
        android:src="@drawable/ic_mic"
        android:contentDescription="Add by voice" />

    <ImageView
        android:id="@+id/widget_quick_add"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:padding="9dp"
        android:background="@drawable/w_btn_accent"
        android:src="@drawable/ic_add"
        android:contentDescription="Add expense" />
</LinearLayout>
