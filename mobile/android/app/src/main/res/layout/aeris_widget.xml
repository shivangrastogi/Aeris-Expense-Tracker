<?xml version="1.0" encoding="utf-8"?>
<!-- 3x2 overview: left to spend this month, progress, today, streak. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/w_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Left to spend"
        android:textAllCaps="true"
        android:letterSpacing="0.12"
        android:textColor="@color/w_muted"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:layout_weight="1" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="8dp"
            android:paddingRight="9dp"
            android:background="@drawable/w_chip">
            <ImageView
                android:id="@+id/widget_fire"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_fire" />
            <TextView
                android:id="@+id/widget_streak_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="0"
                android:textColor="@color/w_text"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_amount"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="—"
        android:textColor="@color/w_text"
        android:textSize="30sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="18sp"
        android:autoSizeMaxTextSize="30sp" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/w_progress" />

    <ProgressBar
        android:id="@+id/widget_progress_over"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progress="100"
        android:visibility="gone"
        android:progressDrawable="@drawable/w_progress_over" />

    <TextView
        android:id="@+id/widget_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Open AERIS to sync"
        android:textColor="@color/w_muted"
        android:textSize="11.5sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
