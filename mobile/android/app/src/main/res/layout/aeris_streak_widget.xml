<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 check-in streak with this week's real days (Sun..Sat). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/w_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_fire"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_fire" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_streak_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 days"
                android:textColor="@color/w_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/widget_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check in daily to build a streak"
                android:textColor="@color/w_muted"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_checkin"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:background="@drawable/w_btn_accent"
            android:text="Check in"
            android:textColor="@color/w_on_accent"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/widget_dot_0"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:background="@drawable/w_dot_off"
                android:textColor="@color/w_on_accent"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/widget_day_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="S"
                android:textColor="@color/w_muted"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/widget_dot_1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:background="@drawable/w_dot_off"
                android:textColor="@color/w_on_accent"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/widget_day_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="M"
                android:textColor="@color/w_muted"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/widget_dot_2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:background="@drawable/w_dot_off"
                android:textColor="@color/w_on_accent"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/widget_day_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="T"
                android:textColor="@color/w_muted"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/widget_dot_3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:background="@drawable/w_dot_off"
                android:textColor="@color/w_on_accent"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/widget_day_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="W"
                android:textColor="@color/w_muted"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/widget_dot_4"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:background="@drawable/w_dot_off"
                android:textColor="@color/w_on_accent"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/widget_day_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="T"
                android:textColor="@color/w_muted"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/widget_dot_5"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:background="@drawable/w_dot_off"
                android:textColor="@color/w_on_accent"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/widget_day_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="F"
                android:textColor="@color/w_muted"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/widget_dot_6"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:background="@drawable/w_dot_off"
                android:textColor="@color/w_on_accent"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/widget_day_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="S"
                android:textColor="@color/w_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
