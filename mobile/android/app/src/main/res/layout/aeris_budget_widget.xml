<?xml version="1.0" encoding="utf-8"?>
<!-- Budget 2x2 widget — glass card with a real circular ring (drawn as a
     bitmap in AerisBudgetWidgetProvider) + "₹X left/over", mirroring the
     in-app preview. RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp"
    android:background="@drawable/aeris_glass_bg">

    <ImageView
        android:id="@+id/widget_ring"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/widget_ring_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="—"
        android:textColor="#15A24A"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_ring_cap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="left"
        android:textColor="#7A8A88"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
