<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 "Today" spend widget — glass card with "Today" + amount, matching the
     in-app preview (was a dark card that read as a green blob at 1x1). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/aeris_glass_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today"
        android:textColor="#7A8A88"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_today_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="—"
        android:textColor="#142838"
        android:textSize="19sp"
        android:textStyle="bold" />

</LinearLayout>
