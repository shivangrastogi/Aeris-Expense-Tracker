<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Both themes are edge-to-edge with transparent system bars and light
         status icons from the very first frame — exactly what Flutter sets in
         main.dart — so nothing changes (no bar fade, no layout jump) when the
         Flutter UI takes over. Same in light and dark system mode, because the
         app itself starts dark. -->
    <style name="AerisWindow" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <!-- Android 12+ system splash (icon screen) on the same dark canvas. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/aeris_void</item>
    </style>

    <!-- While the process starts. -->
    <style name="LaunchTheme" parent="AerisWindow">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Behind the Flutter UI while it initialises and runs. -->
    <style name="NormalTheme" parent="AerisWindow">
        <item name="android:windowBackground">@color/aeris_void</item>
    </style>
</resources>
