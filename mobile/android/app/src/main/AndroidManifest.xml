<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet for Firebase + Google STT in future -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- SMS reading: required for auto-parsing bank/UPI alerts.
         Play Store policy requires a privacy-policy URL and an explicit
         in-app explanation before requesting; we surface that on first run
         via Settings → "Read bank SMS automatically". -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Ask the user to exempt AERIS from battery optimisation so the SMS
         broadcast receiver keeps firing when the app is closed (needed on
         aggressive OEMs like Realme/Xiaomi). Surfaced from Settings only after
         live SMS tracking is enabled. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Local notifications for budget alerts / new-txn confirmations -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Camera for taking a profile photo (gallery needs no permission on
         Android 13+ via the system photo picker). Marked not-required so the
         app still installs on camera-less devices. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Biometric / device-credential app lock (local_auth) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Microphone for in-app voice transaction entry (native SpeechRecognizer). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <!-- Speech recognition service lookup for SpeechRecognizer. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:label="AERIS Expense"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- another_telephony: incoming-SMS broadcast receiver. -->
        <receiver
            android:name="com.shounakmulay.telephony.sms.IncomingSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="1000">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget (budget left), updated via home_widget plugin. -->
        <receiver
            android:name=".AerisWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aeris_widget_info" />
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
